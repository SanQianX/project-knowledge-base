{
  "name": "@sanqianx/project-knowledge",
  "version": "5.5.10",
  "description": "Knowledge base manager with Git integration, AI-driven analysis, and bilingual (zh-CN/en-US) knowledge output",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "node tests/run-all-tests.js",
    "release:sync": "node src/scripts/sync-release-version.js --web-only",
    "runtime:verify": "node src/scripts/verify-module-runtime.js --working-tree",
    "release:verify": "node src/scripts/sync-release-version.js --check --web-only && node src/scripts/verify-module-runtime.js && node src/scripts/verify-product-runtime.js && node tests/integration-adapters-test.js",
    "preversion": "npm run release:verify",
    "version": "node src/scripts/sync-release-version.js --stage --web-only",
    "postversion": "npm run release:verify"
  },
  "bin": {
    "project-knowledge": "bin/project-knowledge.js",
    "project-knowledge-kb": "bin/project-knowledge-kb.js",
    "project-knowledge-mcp": "bin/project-knowledge-mcp.js",
    "project-knowledge-integrations": "bin/project-knowledge-integrations.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "src/server.js",
    "resources/ui/index.html",
    "resources/ui/knowledge-panel.html",
    "resources/ui/product.css",
    "resources/ui/product.js",
    "resources/ui/live-client.js",
    "resources/ui/version-info.js",
    "resources/ui/version-info.css",
    "resources/ui/favicon.svg",
    "src/common/",
