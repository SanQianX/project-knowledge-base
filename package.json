{
  "name": "@sanqianx/project-knowledge",
  "version": "5.0.23",
  "description": "Knowledge base manager with Git integration, AI-driven analysis, and bilingual (zh-CN/en-US) knowledge output",
  "main": "_site/server.js",
  "scripts": {
    "start": "node _site/server.js",
    "test": "node _site/_test/run-all-tests.js",
    "release:sync": "node _site/scripts/sync-release-version.js --web-only",
    "vendor:modules": "node _site/scripts/vendor-modules.js",
    "runtime:verify": "node _site/scripts/verify-module-runtime.js --working-tree",
    "release:verify": "node _site/scripts/sync-release-version.js --check --web-only && node _site/scripts/verify-module-runtime.js && node _site/scripts/verify-product-runtime.js && node _site/_test/integration-adapters-test.js",
    "preversion": "npm run release:verify",
    "version": "node _site/scripts/sync-release-version.js --stage --web-only",
    "postversion": "npm run release:verify"
  },
  "bin": {
    "project-knowledge": "bin/project-knowledge.js",
    "project-knowledge-kb": "bin/project-knowledge-kb.js",
    "project-knowledge-mcp": "bin/project-knowledge-mcp.js",
    "project-knowledge-integrations": "bin/project-knowledge-integrations.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "_site/server.js",
    "ui/index.html",
    "ui/knowledge-panel.html",
    "ui/product.css",
    "ui/product.js",
    "ui/live-client.js",
    "ui/favicon.svg",
    "_site/lib/",
    "_modules/knowledge-engine/",
    "vendor-manifest.json",
    "module-runtime-manifest.json",
    "_site/scripts/",
    "_site/_test/*.js",
    "_site/_test/fixtures/",
    "_site/start.bat",
    "_site/stop.bat",
    "claude-prompts.json",
    "bin/",
    "plugins/",
    ".claude-plugin/",
    ".agents/plugins/",
    "templates/",
    "docs/assets/",
    "docs/README.zh-CN.md",
    "docs/project-registry-schema.md",
    "docs/team-knowledge-mode-a-plan.md",
    "docs/testing-strategy.md",
    "docs/leader-glm-workbench-playbook.md",
    "docs/release-5.0.16-acceptance.md",
    "docs/release-5.0.17-acceptance.md",
    "docs/release-5.0.19-acceptance.md",
    "docs/fresh-v5-start.md",
    "README.md",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SanQianX/project-knowledge-base.git"
  },
  "keywords": [
    "knowledge-base",
    "git",
    "ai",
    "claude",
    "codex",
    "opencode",
    "mcp",
    "documentation",
    "scanner",
    "context-pack",
    "post-commit-hook"
  ],
  "author": "SanQianX",
  "license": "Apache-2.0",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.141",
    "@grpc/grpc-js": "^1.14.5",
    "@grpc/proto-loader": "^0.8.1",
    "@huggingface/transformers": "3.8.1",
    "@lancedb/lancedb": "0.31.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@sanqianx/ai-coding-event-bridge-console": "0.7.2",
    "@sanqianx/vector-hub": "1.0.8-rc.8",
    "buffer": "^6.0.3",
    "cheerio": "^1.2.0",
    "claude-ai-workbench": "npm:@sanqianx/claude-ai-workbench@0.13.5",
    "cross-spawn": "7.0.6",
    "dotenv": "^17.4.2",
    "gpt-tokenizer": "^3.4.0",
    "http-proxy-agent": "7.0.2",
    "https-proxy-agent": "7.0.6",
    "json-colorizer": "^3.0.1",
    "jsonc-parser": "3.3.1",
    "openai": "^6.49.0",
    "socks-proxy-agent": "8.0.5",
    "turndown": "^7.2.4",
    "uuid": "^13.0.2",
    "wink-bm25-text-search": "^3.1.2",
    "wink-nlp": "^2.4.0",
    "ws": "^8.21.0",
    "yargs": "^18.1.0"
  }
}
