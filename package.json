{
  "name": "project-knowledge",
  "version": "4.2.11",
  "description": "Knowledge base manager with Git integration, AI-driven analysis, and bilingual (zh-CN/en-US) knowledge output",
  "main": "_site/server.js",
  "scripts": {
    "start": "node _site/server.js",
    "test": "node _site/_test/run-all-tests.js",
    "release:sync": "node _site/scripts/sync-release-version.js",
    "release:verify": "node _site/scripts/sync-release-version.js --check && node _site/_test/integration-adapters-test.js",
    "preversion": "npm run release:verify",
    "version": "node _site/scripts/sync-release-version.js --stage",
    "postversion": "npm run release:verify"
  },
  "bin": {
    "project-knowledge": "bin/project-knowledge.js",
    "project-knowledge-kb": "bin/project-knowledge-kb.js",
    "project-knowledge-mcp": "bin/project-knowledge-mcp.js",
    "project-knowledge-integrations": "bin/project-knowledge-integrations.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "_site/server.js",
    "ui/index.html",
    "ui/app.css",
    "ui/app.js",
    "ui/favicon.svg",
    "_site/lib/",
    "_site/scripts/",
    "_site/_test/*.js",
    "_site/_test/fixtures/",
    "_site/start.bat",
    "_site/stop.bat",
    "claude-prompts.json",
    "bin/",
    "plugins/",
    ".claude-plugin/",
    ".agents/plugins/",
    "templates/",
    "docs/assets/",
    "docs/README.zh-CN.md",
    "docs/project-registry-schema.md",
    "docs/team-knowledge-mode-a-plan.md",
    "docs/testing-strategy.md",
    "README.md",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SanQianX/project-knowledge-base.git"
  },
  "keywords": [
    "knowledge-base",
    "git",
    "ai",
    "claude",
    "codex",
    "opencode",
    "mcp",
    "documentation",
    "scanner",
    "context-pack",
    "post-commit-hook"
  ],
  "author": "SanQianX",
  "license": "Apache-2.0",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.141",
    "@huggingface/transformers": "3.8.1",
    "@lancedb/lancedb": "0.31.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@sanqianx/ai-coding-event-bridge": "^0.1.1",
    "cross-spawn": "7.0.6",
    "http-proxy-agent": "7.0.2",
    "https-proxy-agent": "7.0.6",
    "jsonc-parser": "3.3.1",
    "socks-proxy-agent": "8.0.5",
    "ws": "^8.21.0"
  }
}
