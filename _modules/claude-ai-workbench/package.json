{
  "name": "claude-ai-workbench",
  "version": "0.3.0",
  "description": "Shared Claude Code terminal and Anthropic-compatible AI profile modules for local developer tools.",
  "type": "commonjs",
  "main": "src/index.js",
  "files": [
    "packages",
    "apps",
    "src",
    "ui",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node scripts/check-package.js",
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js tests/contract/*.test.js",
    "test:real": "node --test tests/real/*.test.js",
    "start": "node packages/server/bin/claude-workbench-server.js",
    "start:agent-terminal": "node packages/server/bin/agent-terminal-server.js",
    "start:test-host": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-test-host.ps1",
    "sdk:check": "node scripts/validate-sdk.js && tsc -p tsconfig.sdk.json",
    "sdk:pack": "node scripts/pack-sdk.js",
    "verify": "npm run check && npm test && npm run sdk:check"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.141"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "yaml": "^2.9.0"
  }
}
