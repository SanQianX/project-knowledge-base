{
  "name": "@claude-ai-workbench/ui",
  "version": "0.3.0",
  "type": "commonjs",
  "main": "ai-profile-settings.js",
  "browser": "ai-profile-settings.js",
  "types": "ai-profile-settings.d.ts",
  "exports": {
    ".": {
      "types": "./ai-profile-settings.d.ts",
      "browser": "./ai-profile-settings.js",
      "default": "./ai-profile-settings.js"
    },
    "./ai-profile-settings": {
      "types": "./ai-profile-settings.d.ts",
      "default": "./ai-profile-settings.js"
    },
    "./claude-terminal": {
      "types": "./claude-terminal.d.ts",
      "browser": "./claude-terminal.js",
      "require": "./claude-terminal.js",
      "default": "./claude-terminal.js"
    },
    "./theme.css": "./theme.css",
    "./package.json": "./package.json"
  },
  "files": ["ai-profile-settings.js", "ai-profile-settings.d.ts", "claude-terminal.js", "claude-terminal.d.ts", "theme.css", "README.md"],
  "dependencies": { "@claude-ai-workbench/core": "0.3.0" },
  "engines": { "node": ">=18" },
  "license": "Apache-2.0"
}
